<Project>
    <Target Name="CopyVoicesToPublish" AfterTargets="Publish" Condition="'$(OutputType)' != 'Library'">
        <ItemGroup>
            <VoiceFiles Include="$(TargetDir)voices\*.npy" />
        </ItemGroup>
        <Copy SourceFiles="@(VoiceFiles)"
              DestinationFolder="$(PublishDir)voices"
              SkipUnchangedFiles="true"
              Condition="Exists('$(TargetDir)voices')"/>
    </Target>
</Project>