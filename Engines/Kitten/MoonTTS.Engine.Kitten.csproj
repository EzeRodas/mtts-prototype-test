<Project Sdk="Microsoft.NET.Sdk">

  <!-- Out-of-process KittenTTS engine worker. It is intentionally not part of MoonTTS.slnx: the host never links it.
       Install with: dotnet publish Engines/Kitten -o "<data>/Moon-TTS/engines/Kitten" -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>kitten-worker</AssemblyName>
    <RootNamespace>MoonTTS.Engine.Kitten</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <StackTraceSupport>true</StackTraceSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MoonTTS.Engine.Protocol\MoonTTS.Engine.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
  </ItemGroup>

  <!-- The manifest and espeak-ng runtime sit next to the worker in the installed engine folder -->
  <ItemGroup>
    <None Include="engine.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Mbrola\runtimes\**\native\*" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Mbrola\espeak-ng-data\**\*" Link="espeak-ng-data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="EnsureNativeEspeakAssets" BeforeTargets="BeforeBuild;AssignTargetPaths"
          Condition="($([MSBuild]::IsOSPlatform('Windows')) And (!Exists('$(MSBuildProjectDirectory)\..\Mbrola\runtimes\win-x64\native\libespeak-ng.dll') Or !Exists('$(MSBuildProjectDirectory)\..\Mbrola\espeak-ng-data\phontab'))) Or (!$([MSBuild]::IsOSPlatform('Windows')) And !Exists('$(MSBuildProjectDirectory)\..\Mbrola\espeak-ng-data\phontab'))">
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Mbrola\build-native.ps1&quot;" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          Command="bash &quot;$(MSBuildProjectDirectory)/../Mbrola/build-native.sh&quot;" />
    <ItemGroup>
      <_EspeakRuntime Include="..\Mbrola\runtimes\**\native\*" />
      <_EspeakData Include="..\Mbrola\espeak-ng-data\**\*" />
      <None Include="@(_EspeakRuntime)" Link="runtimes\%(_EspeakRuntime.RecursiveDir)%(_EspeakRuntime.Filename)%(_EspeakRuntime.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="@(_EspeakData)" Link="espeak-ng-data\%(_EspeakData.RecursiveDir)%(_EspeakData.Filename)%(_EspeakData.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
