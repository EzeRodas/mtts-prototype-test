<Project Sdk="Microsoft.NET.Sdk">

  <!-- Out-of-process MBROLA + eSpeak NG G2P engine worker. It is intentionally not part of MoonTTS.slnx: the host never links it.
       Install with: dotnet publish Engines/Mbrola -o "<data>/Moon-TTS/engines/Mbrola" -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>mbrola-worker</AssemblyName>
    <RootNamespace>MoonTTS.Engine.Mbrola</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <StackTraceSupport>true</StackTraceSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MoonTTS.Engine.Protocol\MoonTTS.Engine.Protocol.csproj" />
  </ItemGroup>

  <!-- The manifest, native library, and G2P phoneme/dictionary tables sit next to the worker in the installed engine folder -->
  <ItemGroup>
    <None Include="engine.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="runtimes\**\native\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="espeak-ng-data\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="EnsureNativeEspeakAssets" BeforeTargets="BeforeBuild;AssignTargetPaths">
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows')) And (!Exists('$(MSBuildProjectDirectory)\runtimes\win-x64\native\libespeak-ng.dll') Or !Exists('$(MSBuildProjectDirectory)\espeak-ng-data\phontab'))"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build-native.ps1&quot;" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows')) And !Exists('$(MSBuildProjectDirectory)\espeak-ng-data\phontab')"
          Command="bash &quot;$(MSBuildProjectDirectory)/build-native.sh&quot;" />
    <ItemGroup>
      <None Remove="runtimes\**\native\*" />
      <None Remove="espeak-ng-data\**\*" />
      <None Include="runtimes\**\native\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="espeak-ng-data\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
