<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MoonTTS.Avalonia.ViewModels"
        xmlns:settingsVm="using:MoonTTS.Avalonia.ViewModels.Settings"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:entities="using:MoonTTS.Domain.Entities"
        xmlns:valueObjects="using:MoonTTS.Domain.ValueObjects"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="540"
        x:Class="MoonTTS.Avalonia.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/icon.ico"
        Title="Settings"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        RequestedThemeVariant="Light"
        Width="320"
        Height="520">


    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}"/>
    </Window.KeyBindings>

    <!-- Global Palette & Resource Constants -->
    <Window.Resources>
        <Color x:Key="ColorPrimary">#6366F1</Color>
        <Color x:Key="ColorPrimaryHover">#4F46E5</Color>
        <Color x:Key="ColorDanger">#EF4444</Color>
        <Color x:Key="ColorDangerBg">#FEE2E2</Color>
        <Color x:Key="ColorSuccess">#10B981</Color>
        <Color x:Key="ColorSurface">#F7F8F9</Color>
        <Color x:Key="ColorBackground">#FFFFFF</Color>
        <Color x:Key="ColorHover">#F3F4F6</Color>
        <Color x:Key="ColorBorder">#E5E7EB</Color>
        <Color x:Key="ColorTextPrimary">#111827</Color>
        <Color x:Key="ColorTextSecondary">#4B5563</Color>
        <Color x:Key="ColorTextMuted">#9CA3AF</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource ColorPrimaryHover}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}"/>
        <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource ColorDangerBg}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}"/>
        <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource ColorHover}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}"/>

        <x:Double x:Key="SliderTrackThemeHeight">8</x:Double>
    </Window.Resources>

    <Panel Margin="6">

        <!-- =============================================================== -->
        <!-- VIEW 1: QUICK SETTINGS CARD (Visible when !IsAdvancedView)      -->
        <!-- =============================================================== -->
        <Border Classes="main-card" Padding="16" IsVisible="{Binding !IsAdvancedView}">
            <Border.BoxShadow>
                <BoxShadows>0 6 10 0 #25000000</BoxShadows>
            </Border.BoxShadow>

            <StackPanel Spacing="5" Name="QuickSettings">
                <!-- Header -->
                <Grid 
                    ColumnDefinitions="*,Auto,Auto"
                    >
                    <TextBlock 
                        Text="{Binding L.Strings.QuickSettingsTitle}" 
                        FontSize="18" 
                        Background="{StaticResource SurfaceBrush}" 
                        FontWeight="Bold" 
                        Foreground="{StaticResource TextPrimaryBrush}" 
                        VerticalAlignment="Center"/>
                    
                    <Panel Grid.Column="1" Margin="0,0,6,0">
                        <Button Name="SwitchAdvancedBtn" Classes="btn-icon"
                                AutomationProperties.Name="{Binding L.Strings.SwitchSettingsModeAria}"
                                Command="{Binding SwitchToAdvancedCommand}">
                            <Path Data="M16 4h4v4 M14 10l6-6 M8 20H4v-4 M4 20l6-6 M16 20h4v-4 M14 14l6 6 M8 4H4v4 M4 4l6 6"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Popup IsOpen="{Binding IsPointerOver, ElementName=SwitchAdvancedBtn}"
                               PlacementTarget="{Binding ElementName=SwitchAdvancedBtn}"
                               Placement="Bottom"
                               VerticalOffset="6"
                               IsLightDismissEnabled="False">
                            <Border Classes="tooltip-popup">
                                <TextBlock Text="{Binding L.Strings.AdvancedSettingsTooltip}" Classes="tooltip-popup-text"/>
                            </Border>
                        </Popup>
                    </Panel>

                    <Panel Grid.Column="2">
                        <Button Name="CloseSettingsBtn" Classes="btn-icon"
                                AutomationProperties.Name="{Binding L.Strings.CloseSettingsAria}"
                                Command="{Binding CloseCommand}">
                            <Path Data="M18 6l-12 12 M6 6l12 12" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Popup IsOpen="{Binding IsPointerOver, ElementName=CloseSettingsBtn}"
                               PlacementTarget="{Binding ElementName=CloseSettingsBtn}"
                               Placement="Bottom"
                               VerticalOffset="6"
                               IsLightDismissEnabled="False">
                            <Border Classes="tooltip-popup">
                                <TextBlock Text="{Binding L.Strings.CloseEscapeTooltip}" Classes="tooltip-popup-text"/>
                            </Border>
                        </Popup>
                    </Panel>
                </Grid>


                <!-- Model & Voice Selection -->
                <Border Classes="card-section" Name="ModelSel">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="75,*">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding L.Strings.ModelLabel}" Classes="field-label" VerticalAlignment="Center"/>
                                <Panel VerticalAlignment="Center">
                                    <Button Name="QuickInfoBtn" Classes="btn-info"
                                            AutomationProperties.Name="{Binding L.Strings.EngineManagementInfoAria}"
                                            Command="{Binding NavigateToEngineManagementCommand}">
                                        <Path Data="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z M12 16v-4 M12 8h.01"
                                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.8"
                                              StrokeLineCap="Round" StrokeJoin="Round"
                                              Width="13" Height="13" Stretch="Uniform"/>
                                    </Button>
                                    <Popup IsOpen="{Binding IsPointerOver, ElementName=QuickInfoBtn}"
                                           PlacementTarget="{Binding ElementName=QuickInfoBtn}"
                                           Placement="Bottom"
                                           VerticalOffset="6"
                                           IsLightDismissEnabled="False">
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                MaxWidth="240">
                                            <Border.BoxShadow>
                                                <BoxShadows>0 4 12 0 #20000000</BoxShadows>
                                            </Border.BoxShadow>
                                            <TextBlock Text="{Binding L.Strings.DownloadEngineInfoTooltip}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </Popup>
                                </Panel>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="model-selector" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="valueObjects:ModelMetadata">
                                        <Panel Name="ModelRow" Background="Transparent" PointerPressed="OnModelRowPointerPressed">
                                            <TextBlock Text="{Binding DisplayName}" IsVisible="{Binding !IsSeparator}"
                                                       Classes.unavailable="{Binding !IsSelectable}"/>
                                            <StackPanel IsVisible="{Binding IsSeparator}" Spacing="4" Margin="0,4,0,2">
                                                <Separator Background="{StaticResource BorderBrush}" Height="1" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <!-- Info card shown under the cursor while hovering a model that is not downloaded yet -->
                                            <Popup PlacementTarget="{Binding ElementName=ModelRow}"
                                                   Placement="Pointer"
                                                   HorizontalOffset="12"
                                                   VerticalOffset="18"
                                                   IsLightDismissEnabled="False"
                                                   IsHitTestVisible="False">
                                                <Popup.IsOpen>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="IsPointerOver" ElementName="ModelRow"/>
                                                        <Binding Path="IsUnavailable"/>
                                                    </MultiBinding>
                                                </Popup.IsOpen>
                                                <Border Background="{StaticResource SurfaceBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="10,8"
                                                        MaxWidth="240">
                                                    <Border.BoxShadow>
                                                        <BoxShadows>0 4 12 0 #20000000</BoxShadows>
                                                    </Border.BoxShadow>
                                                    <TextBlock Text="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).L.Strings.DownloadEngineHoverTooltip}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                </Border>
                                            </Popup>
                                        </Panel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        
                        <Grid ColumnDefinitions="70,*">
                            <TextBlock Text="{Binding L.Strings.VoiceLabel}" Classes="field-label" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableVoices}" SelectedItem="{Binding SelectedVoice}" PlaceholderText="{Binding VoicePlaceholderText}" IsEnabled="{Binding !IsLoadingVoices}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="valueObjects:VoiceInfo">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Audio Output -->
                <Border Classes="card-section">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding L.Strings.AudioOutputLabel}" Classes="field-label" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnablePrimaryPlayback}" OnContent="" OffContent=""/>
                        </Grid>
                        <ComboBox ItemsSource="{Binding AvailableOutputDevices}" 
                                  SelectedItem="{Binding SelectedPrimaryDevice}" 
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="entities:AudioDeviceInfo">
                                    <TextBlock Text="{Binding DeviceName}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid ColumnDefinitions="*,40">
                            <Slider Minimum="0" Maximum="100" Value="{Binding PrimaryVolume}"/>
                            <TextBlock Grid.Column="1" Text="{Binding PrimaryVolume, StringFormat={}{0}%}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Audio Monitoring -->
                <Border Classes="card-section">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding L.Strings.MonitoringLabel}" Classes="field-label" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableMonitorPlayback}" OnContent="" OffContent=""/>
                        </Grid>
                        <ComboBox ItemsSource="{Binding AvailableOutputDevices}" 
                                  SelectedItem="{Binding SelectedMonitorDevice}" 
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="entities:AudioDeviceInfo">
                                    <TextBlock Text="{Binding DeviceName}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid ColumnDefinitions="*,40">
                            <Slider Minimum="0" Maximum="100" Value="{Binding MonitorVolume}"/>
                            <TextBlock Grid.Column="1" Text="{Binding MonitorVolume, StringFormat={}{0}%}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        <Popup Name="ErrorPopup" IsOpen="{Binding ModelStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               PlacementTarget="{Binding ElementName=ModelSel}"
               Placement="Bottom"
               HorizontalAlignment="Center"
               IsLightDismissEnabled="True">
            <Border Width="250"
                    Background="{StaticResource ColorDanger}"
                    CornerRadius="8"
                    Padding="16">
                <TextBlock Text="{Binding ModelStatusMessage}" 
                           Foreground="White" 
                           TextWrapping="Wrap"
                           FontWeight="Medium"
                           TextAlignment="Center"/>
            </Border>
        </Popup>

        <!-- =============================================================== -->
        <!-- VIEW 2: 2-COLUMN ADVANCED DASHBOARD (Visible when IsAdvancedView)-->
        <!-- =============================================================== -->
        <Border Classes="main-card" IsVisible="{Binding IsAdvancedView}" ClipToBounds="True">
            <Border.BoxShadow>
                <BoxShadows>0 15 35 0 #35000000</BoxShadows>
            </Border.BoxShadow>

            <Grid ColumnDefinitions="210,*">
                <!-- Left Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                            <Button Content="{Binding L.Strings.BackToQuickSettings}" Command="{Binding SwitchToQuickCommand}" 
                                    Background="Transparent" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" 
                                    HorizontalAlignment="Stretch" Cursor="Hand"/>
                            <Button Content="{Binding L.Strings.ExitMoonTts}" Command="{Binding ExitAppCommand}" 
                                    Background="Transparent" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" 
                                    HorizontalAlignment="Stretch" Cursor="Hand"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding L.Strings.AdvancedHeader}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,8"/>
                            <Button Content="{Binding L.Strings.GeneralTab}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:AdvancedTab.General}" Classes.active="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.General}}" Classes="nav-item"/>
                            <Button Content="{Binding L.Strings.AudioTab}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:AdvancedTab.Audio}" Classes.active="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.Audio}}" Classes="nav-item"/>
                            <Button Content="{Binding L.Strings.DictionaryTab}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:AdvancedTab.Dictionary}" Classes.active="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.Dictionary}}" Classes="nav-item"/>
                            <Button Content="{Binding L.Strings.TtsEngineTab}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:AdvancedTab.Engine}" Classes.active="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.Engine}}" Classes="nav-item"/>
                            <Button Content="{Binding L.Strings.EngineManagementTab}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:AdvancedTab.EngineManagement}" Classes.active="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.EngineManagement}}" Classes="nav-item"/>
                            <Button Content="{Binding L.Strings.HotkeysTab}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:AdvancedTab.Hotkeys}" Classes.active="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.Hotkeys}}" Classes="nav-item"/>
                            <Button Content="{Binding L.Strings.HistoryTab}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:AdvancedTab.History}" Classes.active="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.History}}" Classes="nav-item"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Right Content Area -->
                <Border Grid.Column="1" Padding="24" Background="{StaticResource SurfaceBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Panel>
                            <!-- General Tab -->
                            <StackPanel Spacing="16" IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.General}}">
                                <TextBlock Text="{Binding L.Strings.GeneralSettingsTitle}" Classes="section-title"/>
                                <TextBlock Text="{Binding L.Strings.GeneralSettingsDesc}" Classes="section-desc"/>
                                <Grid ColumnDefinitions="*,200" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding L.Strings.LanguageLabel}" Classes="field-label" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="entities:LanguageOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <CheckBox Content="{Binding L.Strings.AlwaysOnTopCheck}" IsChecked="{Binding AlwaysOnTop}"/>
                                <CheckBox Content="{Binding L.Strings.HideOnSynthCheck}" IsChecked="{Binding HideOnSynth}"/>
                                <CheckBox Content="{Binding L.Strings.QueueSpeechCheck}" IsChecked="{Binding QueueSpeech}"/>
                                <CheckBox Content="{Binding L.Strings.RememberPositionCheck}" IsChecked="{Binding RememberPosition}"/>
                                <CheckBox Content="{Binding L.Strings.StartMinimizedCheck}" IsChecked="{Binding OpenOnStartup}"/>
                                <CheckBox Content="{Binding L.Strings.CreateVirtualMicCheck}" IsChecked="{Binding CreateMicOnStartup}" IsVisible="{Binding IsLinux}"/>
                                <Button Content="{Binding L.Strings.OpenLogsButton}" Command="{Binding OpenLogsFolderCommand}" Classes="hotkey-btn" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Audio Tab -->
                            <StackPanel Spacing="16" IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.Audio}}">
                                <TextBlock Text="{Binding L.Strings.AudioSettingsTitle}" Classes="section-title"/>
                                <Border Classes="card-section">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding L.Strings.AudioPlaybackLabel}" Classes="field-label"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnablePrimaryPlayback}" OnContent="" OffContent=""/>
                                        </Grid>
                                        <ComboBox ItemsSource="{Binding AvailableOutputDevices}" SelectedItem="{Binding SelectedPrimaryDevice}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate><DataTemplate x:DataType="entities:AudioDeviceInfo"><TextBlock Text="{Binding DeviceName}"/></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Grid ColumnDefinitions="*,40">
                                            <Slider Minimum="0" Maximum="100" Value="{Binding PrimaryVolume}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PrimaryVolume, StringFormat={}{0}%}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Classes="card-section">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding L.Strings.AudioMonitoringVirtualMicLabel}" Classes="field-label"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableMonitorPlayback}" OnContent="" OffContent=""/>
                                        </Grid>
                                        <ComboBox ItemsSource="{Binding AvailableOutputDevices}" SelectedItem="{Binding SelectedMonitorDevice}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate><DataTemplate x:DataType="entities:AudioDeviceInfo"><TextBlock Text="{Binding DeviceName}"/></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Grid ColumnDefinitions="*,40">
                                            <Slider Minimum="0" Maximum="100" Value="{Binding MonitorVolume}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MonitorVolume, StringFormat={}{0}%}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Dictionary Tab -->
                            <StackPanel Spacing="16" IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.Dictionary}}">
                                <TextBlock Text="{Binding L.Strings.PhoneticDictionaryTitle}" Classes="section-title"/>
                                <Border Classes="card-section">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding L.Strings.AddWordReplacementLabel}" Classes="field-label"/>
                                        <Grid ColumnDefinitions="*,*,Auto">
                                            <TextBox Text="{Binding Dictionary.NewDictOriginal}" PlaceholderText="{Binding L.Strings.OriginalWordPlaceholder}" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding Dictionary.NewDictSpelling}" PlaceholderText="{Binding L.Strings.SpellingReplacementPlaceholder}" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Content="{Binding L.Strings.AddButton}" Command="{Binding Dictionary.AddEntryCommand}" Classes="btn-primary" Cursor="Hand"/>
                                        </Grid>
                                        <CheckBox Content="{Binding L.Strings.CaseSensitiveCheck}" IsChecked="{Binding Dictionary.NewDictCaseSensitive}"/>
                                    </StackPanel>
                                </Border>
                                <ListBox ItemsSource="{Binding Dictionary.Entries}" Height="200" Classes="data-list">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="entities:DictionaryEntry">
                                            <Grid ColumnDefinitions="*,*,Auto">
                                                <TextBlock Text="{Binding Original}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Spelling}" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                                <Panel Grid.Column="2">
                                                    <Button Name="DeleteDictBtn" AutomationProperties.Name="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).L.Strings.DeleteDictionaryEntryAria}" Content="✕" Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).Dictionary.DeleteEntryCommand}" CommandParameter="{Binding Id}" Classes="btn-icon btn-delete"/>
                                                    <Popup IsOpen="{Binding IsPointerOver, ElementName=DeleteDictBtn}"
                                                           PlacementTarget="{Binding ElementName=DeleteDictBtn}"
                                                           Placement="Top"
                                                           VerticalOffset="-4"
                                                           IsLightDismissEnabled="False">
                                                        <Border Classes="tooltip-popup">
                                                            <TextBlock Text="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).L.Strings.DeleteButton}" Classes="tooltip-popup-text"/>
                                                        </Border>
                                                    </Popup>
                                                </Panel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- TTS Engine Tab -->
                            <StackPanel Spacing="16" IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.Engine}}">
                                <TextBlock Text="{Binding L.Strings.TtsEngineConfigTitle}" Classes="section-title"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding L.Strings.ActiveModelLabel}" Classes="field-label" VerticalAlignment="Center"/>
                                    <Panel VerticalAlignment="Center">
                                        <Button Name="AdvancedInfoBtn" Classes="btn-info"
                                                AutomationProperties.Name="{Binding L.Strings.EngineManagementInfoAria}"
                                                Command="{Binding NavigateToEngineManagementCommand}">
                                            <Path Data="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z M12 16v-4 M12 8h.01"
                                                  Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.8"
                                                  StrokeLineCap="Round" StrokeJoin="Round"
                                                  Width="13" Height="13" Stretch="Uniform"/>
                                        </Button>
                                        <Popup IsOpen="{Binding IsPointerOver, ElementName=AdvancedInfoBtn}"
                                               PlacementTarget="{Binding ElementName=AdvancedInfoBtn}"
                                               Placement="Bottom"
                                               VerticalOffset="6"
                                               IsLightDismissEnabled="False">
                                            <Border Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,8"
                                                    MaxWidth="260">
                                                <Border.BoxShadow>
                                                    <BoxShadows>0 4 12 0 #20000000</BoxShadows>
                                                </Border.BoxShadow>
                                                <TextBlock Text="{Binding L.Strings.DownloadEngineInfoTooltip}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </Popup>
                                    </Panel>
                                </StackPanel>
                                <ComboBox Classes="model-selector" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="valueObjects:ModelMetadata">
                                            <Panel Name="ModelRow" Background="Transparent" PointerPressed="OnModelRowPointerPressed">
                                                <TextBlock Text="{Binding DisplayName}" IsVisible="{Binding !IsSeparator}"
                                                           Classes.unavailable="{Binding !IsSelectable}"/>
                                                <StackPanel IsVisible="{Binding IsSeparator}" Spacing="4" Margin="0,4,0,2">
                                                    <Separator Background="{StaticResource BorderBrush}" Height="1" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                            <!-- Info card shown under the cursor while hovering a model that is not downloaded yet -->
                                            <Popup PlacementTarget="{Binding ElementName=ModelRow}"
                                                   Placement="Pointer"
                                                   HorizontalOffset="12"
                                                   VerticalOffset="18"
                                                   IsLightDismissEnabled="False"
                                                   IsHitTestVisible="False">
                                                <Popup.IsOpen>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="IsPointerOver" ElementName="ModelRow"/>
                                                        <Binding Path="IsUnavailable"/>
                                                    </MultiBinding>
                                                </Popup.IsOpen>
                                                <Border Background="{StaticResource SurfaceBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="10,8"
                                                        MaxWidth="240">
                                                    <Border.BoxShadow>
                                                        <BoxShadows>0 4 12 0 #20000000</BoxShadows>
                                                    </Border.BoxShadow>
                                                    <TextBlock Text="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).L.Strings.DownloadEngineHoverTooltip}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                </Border>
                                            </Popup>
                                            </Panel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding ModelStatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                           IsVisible="{Binding ModelStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="{Binding L.Strings.VoicePresetLabel}" Classes="field-label"/>
                                <ComboBox ItemsSource="{Binding AvailableVoices}" SelectedItem="{Binding SelectedVoice}" PlaceholderText="{Binding VoicePlaceholderText}" IsEnabled="{Binding !IsLoadingVoices}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="valueObjects:VoiceInfo">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Grid ColumnDefinitions="*,50">
                                    <TextBlock Text="{Binding L.Strings.SynthesisSpeedLabel}" Classes="field-label"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SpeechSpeed, StringFormat={}{0:0.0}x}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider Minimum="0.5" Maximum="2.0" Value="{Binding SpeechSpeed}"/>
                                <TextBlock Text="{Binding L.Strings.CustomModelsDirectoryLabel}" Classes="field-label"/>
                                <TextBox Text="{Binding CustomModelsDirectory}" PlaceholderText="{Binding L.Strings.CustomModelsDirectoryPlaceholder}"/>
                            </StackPanel>

                            <!-- Engine Management Tab -->
                            <StackPanel Spacing="16" IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.EngineManagement}}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding L.Strings.EngineManagementTitle}" Classes="section-title"/>
                                    <Button Grid.Column="1" Content="{Binding L.Strings.RescanEnginesButton}" Command="{Binding EngineManagement.RescanEnginesCommand}" Classes="hotkey-btn" Cursor="Hand"/>
                                </Grid>
                                <TextBlock Text="{Binding L.Strings.EngineManagementDesc}" Classes="section-desc"/>
                                <TextBlock Text="{Binding ModelStatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                           IsVisible="{Binding ModelStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                <ItemsControl ItemsSource="{Binding EngineManagement.ModelStatuses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="settingsVm:ModelStatusItem">
                                            <Panel>
                                                <!-- Engine Group Separator & Header -->
                                                <StackPanel IsVisible="{Binding IsSeparator}" Margin="0,14,0,8" Spacing="6">
                                                    <Separator Background="{StaticResource BorderBrush}" Height="1"/>
                                                    <TextBlock Text="{Binding SeparatorTitle}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                </StackPanel>

                                                <!-- Model Card -->
                                                <Border Classes="card-section" IsVisible="{Binding !IsSeparator}">
                                                    <StackPanel Spacing="8">
                                                        <StackPanel Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                                                            <!-- Model Tags: Size, Ram usage, CPU usage -->
                                                            <WrapPanel Orientation="Horizontal" IsVisible="{Binding HasTags}">
                                                                <Border Classes="model-tag" IsVisible="{Binding SizeTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <TextBlock Text="{Binding SizeTag}" Classes="model-tag-text"/>
                                                                </Border>
                                                                <Border Classes="model-tag" IsVisible="{Binding RamUsageTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <TextBlock Text="{Binding RamUsageTag}" Classes="model-tag-text"/>
                                                                </Border>
                                                                <Border Classes="model-tag"
                                                                        Classes.cpu-low="{Binding IsCpuLow}"
                                                                        Classes.cpu-medium="{Binding IsCpuMedium}"
                                                                        Classes.cpu-high="{Binding IsCpuHigh}"
                                                                        IsVisible="{Binding CpuUsageTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <TextBlock Text="{Binding CpuUsageTag}" Classes="model-tag-text"/>
                                                                </Border>
                                                                <Panel IsVisible="{Binding LanguageTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <Border Name="LanguageTagBorder" Classes="model-tag">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding LanguageTag}" Classes="model-tag-text" VerticalAlignment="Center"/>
                                                                            <Path Data="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z M12 16v-4 M12 8h.01"
                                                                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8"
                                                                                  StrokeLineCap="Round" StrokeJoin="Round"
                                                                                  Width="11" Height="11" Stretch="Uniform"
                                                                                  VerticalAlignment="Center"
                                                                                  IsVisible="{Binding HasMultipleLanguages}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Popup PlacementTarget="{Binding ElementName=LanguageTagBorder}"
                                                                           Placement="Bottom"
                                                                           VerticalOffset="6"
                                                                           IsLightDismissEnabled="False"
                                                                           IsHitTestVisible="False">
                                                                        <Popup.IsOpen>
                                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                                <Binding Path="IsPointerOver" ElementName="LanguageTagBorder"/>
                                                                                <Binding Path="HasMultipleLanguages"/>
                                                                            </MultiBinding>
                                                                        </Popup.IsOpen>
                                                                        <Border Background="{StaticResource SurfaceBrush}"
                                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="8"
                                                                                Padding="10,8"
                                                                                MaxWidth="260">
                                                                            <Border.BoxShadow>
                                                                                <BoxShadows>0 4 12 0 #20000000</BoxShadows>
                                                                            </Border.BoxShadow>
                                                                            <TextBlock Text="{Binding LanguagesPopupText}"
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       FontSize="12"
                                                                                       TextWrapping="Wrap"/>
                                                                        </Border>
                                                                    </Popup>
                                                                </Panel>
                                                            </WrapPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding L.Strings.InstalledBadge}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"
                                                                           VerticalAlignment="Center" IsVisible="{Binding IsDownloaded}"/>
                                                                <Button Content="{Binding L.Strings.DeleteButton}" Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).EngineManagement.DeleteModelCommand}"
                                                                        CommandParameter="{Binding}" Classes="btn-danger" IsVisible="{Binding CanDelete}" Cursor="Hand"/>
                                                                <Button Content="{Binding L.Strings.DownloadButton}" Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).EngineManagement.DownloadModelCommand}"
                                                                        CommandParameter="{Binding}" Classes="btn-primary" IsVisible="{Binding CanDownload}" Cursor="Hand"/>
                                                                <Button Content="{Binding L.Strings.CancelDownloadButton}" Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).EngineManagement.CancelDownloadCommand}"
                                                                        CommandParameter="{Binding}" Classes="btn-danger" IsVisible="{Binding IsDownloading}" Cursor="Hand"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="4" CornerRadius="2" IsVisible="{Binding IsDownloading}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Hotkeys Tab -->
                            <StackPanel Spacing="8" IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.Hotkeys}}">
                                <TextBlock Text="{Binding L.Strings.GlobalHotkeysTitle}" Classes="section-title"/>

                                <TextBlock Text="{Binding L.Strings.GlobalToggleShortcutLabel}" Classes="field-label"/>

                                <!-- Global Toggle Hotkey Detection -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Classes="hotkey-btn"
                                            Classes.recording="{Binding Hotkeys.IsRecordingToggleHotkey}"
                                            Content="{Binding Hotkeys.ToggleHotkeyDisplayText}"
                                            Command="{Binding Hotkeys.ToggleRecordingToggleHotkeyCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{Binding Hotkeys.ToggleRecordButtonText}"
                                            Command="{Binding Hotkeys.ToggleRecordingToggleHotkeyCommand}"
                                            Classes="btn-primary" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="{Binding L.Strings.ActiveProfileLabel}" Classes="field-label"/>
                                <!-- Profile Selector & Editable Row Swap -->
                                <Panel>
                                    <!-- Normal Selector Mode -->
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" IsVisible="{Binding !Hotkeys.IsEditingProfile}">
                                        <ComboBox ItemsSource="{Binding Hotkeys.AvailableProfiles}"
                                                  SelectedItem="{Binding Hotkeys.SelectedProfile}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="entities:HotkeyProfile">
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1" Content="{Binding L.Strings.AddButton}"
                                                Command="{Binding Hotkeys.StartAddProfileCommand}"
                                                Classes="btn-primary" Margin="8,0,0,0" Cursor="Hand"/>
                                        <Button Grid.Column="2" Content="{Binding L.Strings.RenameButton}"
                                                Command="{Binding Hotkeys.StartRenameProfileCommand}"
                                                Classes="btn-primary" Margin="6,0,0,0" Cursor="Hand"/>
                                        <Button Grid.Column="3" Content="{Binding L.Strings.DeleteButton}"
                                                Command="{Binding Hotkeys.DeleteProfileCommand}"
                                                Classes="btn-danger" Margin="6,0,0,0" Cursor="Hand"/>
                                    </Grid>

                                    <!-- Editable Row Swap Mode -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding Hotkeys.IsEditingProfile}">
                                        <TextBox Text="{Binding Hotkeys.NewProfileName}"
                                                 PlaceholderText="{Binding L.Strings.ProfileNamePlaceholder}"
                                                 HorizontalAlignment="Stretch">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding Hotkeys.ConfirmAddProfileCommand}"/>
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Content="{Binding L.Strings.SaveButton}"
                                                Command="{Binding Hotkeys.ConfirmAddProfileCommand}"
                                                Classes="btn-primary" Margin="8,0,0,0" Cursor="Hand"/>
                                        <Button Grid.Column="2" Content="{Binding L.Strings.CancelButton}"
                                                Command="{Binding Hotkeys.CancelAddProfileCommand}"
                                                Classes="btn-danger" Margin="6,0,0,0" Cursor="Hand"/>
                                    </Grid>
                                </Panel>

                                <Border Classes="card-section">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding L.Strings.AddPhraseShortcutLabel}" Classes="field-label"/>
                                        <Grid ColumnDefinitions="160,*,Auto">
                                            <!-- Phrase Hotkey Detection -->
                                            <Button Classes="hotkey-btn"
                                                    Classes.recording="{Binding Hotkeys.IsRecordingPhraseHotkey}"
                                                    Content="{Binding Hotkeys.PhraseHotkeyDisplayText}"
                                                    Command="{Binding Hotkeys.ToggleRecordingPhraseHotkeyCommand}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding Hotkeys.NewHotkeyPhrase}" PlaceholderText="{Binding L.Strings.PhraseToSynthesizePlaceholder}" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Content="{Binding L.Strings.AddButton}" Command="{Binding Hotkeys.AddHotkeyPhraseCommand}" Classes="btn-primary" Cursor="Hand"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ModelStatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                                   IsVisible="{Binding ModelStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Border>
                                <ListBox ItemsSource="{Binding Hotkeys.HotkeyEntries}" Height="180" Classes="data-list">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="entities:HotkeyEntry">
                                            <Grid ColumnDefinitions="120,*,Auto,Auto">
                                                <TextBlock Text="{Binding Hotkey}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Panel Grid.Column="2" Margin="0,0,4,0">
                                                    <Button Name="PlayHotkeyBtn" Content="▶"
                                                            AutomationProperties.Name="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).L.Strings.PlayHotkeyPhraseAria}"
                                                            Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).Hotkeys.PlayHotkeyPhraseCommand}"
                                                            CommandParameter="{Binding Id}" Classes="btn-icon"/>
                                                    <Popup IsOpen="{Binding IsPointerOver, ElementName=PlayHotkeyBtn}"
                                                           PlacementTarget="{Binding ElementName=PlayHotkeyBtn}"
                                                           Placement="Top"
                                                           VerticalOffset="-4"
                                                           IsLightDismissEnabled="False">
                                                        <Border Classes="tooltip-popup">
                                                            <TextBlock Text="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).L.Strings.PlayButton}" Classes="tooltip-popup-text"/>
                                                        </Border>
                                                    </Popup>
                                                </Panel>
                                                <Panel Grid.Column="3">
                                                    <Button Name="DeleteHotkeyBtn" Content="✕"
                                                            AutomationProperties.Name="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).L.Strings.DeleteHotkeyAria}"
                                                            Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).Hotkeys.DeleteHotkeyPhraseCommand}"
                                                            CommandParameter="{Binding Id}" Classes="btn-icon btn-delete"/>
                                                    <Popup IsOpen="{Binding IsPointerOver, ElementName=DeleteHotkeyBtn}"
                                                           PlacementTarget="{Binding ElementName=DeleteHotkeyBtn}"
                                                           Placement="Top"
                                                           VerticalOffset="-4"
                                                           IsLightDismissEnabled="False">
                                                        <Border Classes="tooltip-popup">
                                                            <TextBlock Text="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).L.Strings.DeleteButton}" Classes="tooltip-popup-text"/>
                                                        </Border>
                                                    </Popup>
                                                </Panel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>


                            <!-- History Tab -->
                            <StackPanel Spacing="16" IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AdvancedTab.History}}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding L.Strings.SynthesisHistoryTitle}" Classes="section-title"/>
                                    <Button Grid.Column="1" Content="{Binding L.Strings.ClearAllButton}" Command="{Binding History.ClearAllCommand}" Classes="btn-danger" Cursor="Hand"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding History.Entries}" Height="240" Classes="data-list">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="entities:HistoryEntry">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"/>
                                                <Panel Grid.Column="1" Margin="4,0">
                                                    <Button Name="PlayHistoryBtn" AutomationProperties.Name="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).L.Strings.PlayHistoryEntryAria}" Content="▶" Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).History.PlayItemCommand}" CommandParameter="{Binding Id}" Classes="btn-icon"/>
                                                    <Popup IsOpen="{Binding IsPointerOver, ElementName=PlayHistoryBtn}"
                                                           PlacementTarget="{Binding ElementName=PlayHistoryBtn}"
                                                           Placement="Top"
                                                           VerticalOffset="-4"
                                                           IsLightDismissEnabled="False">
                                                        <Border Classes="tooltip-popup">
                                                            <TextBlock Text="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).L.Strings.PlayButton}" Classes="tooltip-popup-text"/>
                                                        </Border>
                                                    </Popup>
                                                </Panel>
                                                <Panel Grid.Column="2">
                                                    <Button Name="DeleteHistoryBtn" AutomationProperties.Name="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).L.Strings.DeleteHistoryEntryAria}" Content="✕" Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).History.DeleteItemCommand}" CommandParameter="{Binding Id}" Classes="btn-icon btn-delete"/>
                                                    <Popup IsOpen="{Binding IsPointerOver, ElementName=DeleteHistoryBtn}"
                                                           PlacementTarget="{Binding ElementName=DeleteHistoryBtn}"
                                                           Placement="Top"
                                                           VerticalOffset="-4"
                                                           IsLightDismissEnabled="False">
                                                        <Border Classes="tooltip-popup">
                                                            <TextBlock Text="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).L.Strings.DeleteButton}" Classes="tooltip-popup-text"/>
                                                        </Border>
                                                    </Popup>
                                                </Panel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Panel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Panel>

    <!-- Global Style Classes -->
    <Window.Styles>
        <Style Selector="Border.main-card">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.card-section">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #20000000"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.section-desc">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,-10,0,10"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
        </Style>
        <Style Selector="Button.btn-danger">
            <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.btn-delete">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style Selector="Button.btn-info">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.btn-info:pointerover">
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="Button.btn-info:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav-item">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.nav-item.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.nav-item.active">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ListBox.data-list">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.hotkey-btn">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.hotkey-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>
        <Style Selector="Button.hotkey-btn.recording">
            <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="ComboBox.model-selector ComboBoxItem" x:DataType="valueObjects:ModelMetadata">
            <Setter Property="IsEnabled" Value="{Binding !IsSeparator}"/>
            <Setter Property="IsHitTestVisible" Value="{Binding !IsSeparator}"/>
        </Style>
        <Style Selector="TextBlock.unavailable">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Border.model-tag">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,2,6,2"/>
        </Style>
        <Style Selector="TextBlock.model-tag-text">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.model-tag.cpu-low">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
        </Style>
        <Style Selector="Border.model-tag.cpu-low > TextBlock">
            <Setter Property="Foreground" Value="#065F46"/>
        </Style>
        <Style Selector="Border.model-tag.cpu-medium">
            <Setter Property="Background" Value="#FFFBEB"/>
            <Setter Property="BorderBrush" Value="#FDE68A"/>
        </Style>
        <Style Selector="Border.model-tag.cpu-medium > TextBlock">
            <Setter Property="Foreground" Value="#92400E"/>
        </Style>
        <Style Selector="Border.model-tag.cpu-high">
            <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
        </Style>
        <Style Selector="Border.model-tag.cpu-high > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style Selector="Border.tooltip-popup">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BoxShadow" Value="0 4 12 0 #20000000"/>
        </Style>
        <Style Selector="TextBlock.tooltip-popup-text">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Slider:horizontal /template/ RepeatButton">
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton /template/ Border#TrackBackground">
            <Setter Property="CornerRadius" Value="4,0,0,4"/>
            <Setter Property="Margin" Value="0,0,-10,0"/>
        </Style>
        <Style Selector="Slider:horizontal /template/ RepeatButton#PART_IncreaseButton /template/ Border#TrackBackground">
            <Setter Property="CornerRadius" Value="0,4,4,0"/>
            <Setter Property="Margin" Value="-10,0,0,0"/>
        </Style>
    </Window.Styles>
</Window>
